{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "Compositor",
  "outputfilename": "Compositor",
  "info": {
    "productVersion": "0.1.0",
    "fileAssociations": [
      {
        "ext": "comp",
        "name": "Compositor.Project",
        "description": "Compositor 项目",
        "iconName": "appicon",
        "role": "Editor"
      }
    ]
  },
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "preBuildHooks": {
    "windows/*": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-ml-assets.ps1 -CacheOnly -Platform ${platform}"
  },
  "postBuildHooks": {
    "windows/*": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-ml-assets.ps1 -Offline -Platform ${platform}"
  }
}
