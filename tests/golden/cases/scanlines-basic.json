{
  "kernel": "scanlines",
  "input": "blend",
  "width": 48, "height": 48,
  "epsilon": 1,
  "params": {
    "spacing": 6, "thickness": 0.7, "dots": 0, "wobble": 0, "displace": 0,
    "threshold": 0, "split": 0, "density": 0, "contrast": 0, "blackLevel": 0.2,
    "smoothness": 0.5, "originalColors": 0,
    "dark": [0, 0, 0], "light": [255, 255, 255]
  },
  "note": "scanlines_apply：黑白直出 + 黑位 0.2，渐变输入覆盖 alpha 软边；对齐 ScanlinesTests.scanlinesAreLinesOfLightThatBloomWithBrightness。powf/exp2f/sqrtf 跨库 → ε=1。"
}
